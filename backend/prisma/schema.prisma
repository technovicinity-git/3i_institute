generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum CourseType {
  REGULAR
  ONLINE
  MIXED
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  password          String
  role              UserRole      @default(STUDENT)
  status            AccountStatus @default(PENDING)
  emailVerified     Boolean       @default(false)
  verificationToken String?       @unique
  tokenExpiresAt    DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  profile       Profile?
  sessions      RefreshToken[]
  enrollments   Enrollment[]
  studentExams  StudentExam[]
  courses       Course[]
  batchStudents BatchStudent[]
  subscription  Subscription?
  wishlists     Wishlist[]
  studentNotes  StudentNote[]
  videoProgress VideoProgress[]
  questions Question[]
  certificates Certificate[]
  waiverRequests WaiverRequest[]

  @@map("users")
}

model Profile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  firstName              String
  lastName               String
  phone                  String?
  avatar                 String?
  bio                    String?
  dateOfBirth            DateTime?
  gender                 String?
  address                String?
  city                   String?
  country                String?
  academicInfo           String?
  professionalExperience String?
  cvUrl                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  coverImage  String?
  topicId     String?
  subjectId   String?
  type        CourseType   @default(REGULAR)
  status      CourseStatus @default(DRAFT)
  teacherId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  teacher     User          @relation(fields: [teacherId], references: [id])
  topic       Topic?        @relation(fields: [topicId], references: [id])
  subject     Subject?      @relation(fields: [subjectId], references: [id])
  enrollments Enrollment[]
  examPapers  ExamPaper[]
  batches     Batch[]
  wishlists    Wishlist[]
  studentNotes StudentNote[]
  materials CourseMaterial[]
  certificates Certificate[]
  waiverRequests WaiverRequest[]

  @@map("courses")
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  completed  Boolean  @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}


model StudentExam {
  id          String    @id @default(uuid())
  userId      String
  examPaperId String
  score       Int?
  submittedAt DateTime @default(now())
  reviewed    Boolean  @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examPaper ExamPaper @relation(fields: [examPaperId], references: [id])

  @@map("student_exams")
}

model Topic {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subjects Subject[]
  courses  Course[]

  @@map("topics")
}

model Subject {
  id          String    @id @default(uuid())
  name        String
  description String?
  topicId     String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  topic   Topic    @relation(fields: [topicId], references: [id])
  courses Course[]

  @@unique([name, topicId])
  @@map("subjects")
}

model Batch {
  id        String    @id @default(uuid())
  name      String
  capacity  Int
  isClosed  Boolean   @default(false)
  courseId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course   Course          @relation(fields: [courseId], references: [id])
  sessions BatchSession[]
  students BatchStudent[]

  @@map("batches")
}

model BatchSession {
  id          String    @id @default(uuid())
  batchId     String
  title       String
  date        DateTime
  time        String
  notes       String?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batch Batch @relation(fields: [batchId], references: [id])

  @@map("batch_sessions")
}

model BatchStudent {
  id        String   @id @default(uuid())
  batchId   String
  userId    String
  joinedAt  DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([batchId, userId])
  @@map("batch_students")
}

model Subscription {
  id           String    @id @default(uuid())
  userId       String    @unique
  isActive     Boolean   @default(true)
  subscribedAt DateTime  @default(now())
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  addedAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("wishlists")
}

model StudentNote {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("student_notes")
}

enum MaterialType {
  VIDEO
  PDF
  AUDIO
  IMAGE
  DOCUMENT
}

model CourseMaterial {
  id          String       @id @default(uuid())
  courseId    String
  title       String
  description String?
  type        MaterialType
  url         String
  duration    Int?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course        Course          @relation(fields: [courseId], references: [id])
  videoProgress VideoProgress[]

  @@map("course_materials")
}

model VideoProgress {
  id           String    @id @default(uuid())
  userId       String
  materialId   String
  lastPosition Float     @default(0)
  watched      Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@map("video_progress")
}

enum QuestionType {
  MCQ
  SHORT
}

model Question {
  id              String       @id @default(uuid())
  type            QuestionType
  question        String
  options         String?
  correctAnswer   String?
  suggestedAnswer String?
  marks           Int
  courseId        String?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy    User               @relation(fields: [createdById], references: [id])
  examQuestions ExamQuestion[]

  @@map("questions")
}

model ExamPaper {
  id           String    @id @default(uuid())
  courseId     String
  title        String
  duration     Int
  totalMarks   Int
  passingMarks Int
  isFinalExam  Boolean   @default(false)
  randomOrder  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course        Course          @relation(fields: [courseId], references: [id])
  examQuestions ExamQuestion[]
  studentExams  StudentExam[]

  @@map("exam_papers")
}

model ExamQuestion {
  id          String @id @default(uuid())
  examPaperId String
  questionId  String
  marks       Int

  examPaper ExamPaper @relation(fields: [examPaperId], references: [id])
  question  Question  @relation(fields: [questionId], references: [id])

  @@unique([examPaperId, questionId])
  @@map("exam_questions")
}

enum CertificateType {
  ATTENDANCE
  COMPLETION
}

model Certificate {
  id                String          @id @default(uuid())
  userId            String
  courseId          String
  type              CertificateType
  certificateNumber String          @unique
  issuedAt          DateTime        @default(now())
  createdAt         DateTime        @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId, type])
  @@map("certificates")
}

model WaiverRequest {
  id                 String    @id @default(uuid())
  userId             String
  courseId           String
  reason             String
  supportingInfo     String?
  status             String    @default("PENDING")
  discountPercentage Int       @default(0)
  rejectionReason    String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@map("waiver_requests")
}